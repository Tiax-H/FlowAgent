# ── Server ────────────────────────────────────────────────
PORT=3000
DATABASE_URL="file:./data/flowagent.db"

# ── LLM Providers（OpenAI 兼容；支持聚合平台：一把 key 调多模型）────
# 命名规则：FLOWAGENT_PROVIDERS_<NAME>__BASEURL / __APIKEY / __MODELS
# Agent 节点通过 Provider 名称 + 模型名路由；key 只存此处，严禁提交真实值

# 示例 1：OpenAI 官方
FLOWAGENT_PROVIDERS_OPENAI__BASEURL=https://api.openai.com/v1
FLOWAGENT_PROVIDERS_OPENAI__APIKEY=sk-xxxx
FLOWAGENT_PROVIDERS_OPENAI__MODELS=gpt-4o,gpt-4o-mini

# 示例 2：任意 OpenAI 兼容聚合平台 / 中转站（DeepSeek、Qwen、MIMO 等）
FLOWAGENT_PROVIDERS_AGGREGATOR__BASEURL=https://your-aggregator.example.com/v1
FLOWAGENT_PROVIDERS_AGGREGATOR__APIKEY=sk-xxxx
FLOWAGENT_PROVIDERS_AGGREGATOR__MODELS=deepseek-chat,qwen-max

# ── Demo MCP Servers ──────────────────────────────────────
MCP_SEARCH_SERVER_CMD="node servers/search/dist/index.js"
MCP_SANDBOX_ENABLED=true
