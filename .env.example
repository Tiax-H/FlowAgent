# ── Server ────────────────────────────────────────────────
PORT=3000
# 默认只监听本机回环（127.0.0.1）；确需对外暴露时改 HOST=0.0.0.0 并自行加反向代理与鉴权
# HOST=127.0.0.1
# 允许跨源访问的前端来源（逗号分隔，默认 Vite dev server）
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL="file:./data/flowagent.db"

# ── LLM Providers（OpenAI 兼容；支持聚合平台：一把 key 调多模型）────
# 命名规则：FLOWAGENT_PROVIDERS_<NAME>__BASEURL / __APIKEY / __MODELS
# Agent 节点通过 Provider 名称 + 模型名路由；key 只存此处，严禁提交真实值

# 示例 1：OpenAI 官方
FLOWAGENT_PROVIDERS_OPENAI__BASEURL=https://api.openai.com/v1
FLOWAGENT_PROVIDERS_OPENAI__APIKEY=sk-xxxx
FLOWAGENT_PROVIDERS_OPENAI__MODELS=gpt-4o,gpt-4o-mini

# 示例 2：任意 OpenAI 兼容聚合平台 / 中转站（DeepSeek、Qwen、MIMO 等）
FLOWAGENT_PROVIDERS_AGGREGATOR__BASEURL=https://your-aggregator.example.com/v1
FLOWAGENT_PROVIDERS_AGGREGATOR__APIKEY=sk-xxxx
FLOWAGENT_PROVIDERS_AGGREGATOR__MODELS=deepseek-chat,qwen-max

# ── Provider 网页端配置（加密存储）────────────────────────
# 设置本项后即可在 Web「设置」页增删改查 Provider，无需再改 .env 重启；
# apiKey 以 AES-256-GCM 加密落库，密钥不回显。可用 `openssl rand -hex 32` 生成。
# 注意：更换本值后，此前网页端保存的 Provider 将无法解密，需重新录入。
# FLOWAGENT_SECRET_KEY=change-me-to-a-long-random-string

# ── Demo MCP Servers ──────────────────────────────────────
# 注意：demo Server 不经环境变量自动注册，请在 Web「MCP Servers」页手动添加连接；
# stdio 子进程继承 server 进程 cwd，配置时请使用绝对路径（先 pnpm build 生成 dist）
# 示例命令（填写到 MCP Servers 页，而非此文件）：
#   node /absolute/path/to/servers/search/dist/index.js
#   node /absolute/path/to/servers/sandbox/dist/index.js
#   node /absolute/path/to/servers/report/dist/index.js
