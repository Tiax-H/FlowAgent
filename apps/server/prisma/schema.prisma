generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 工作流定义（definition 为 WorkflowDefinition 的 JSON 序列化）
model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  definition  String
  /// 每次成功更新 definition 自增，供执行时锁定版本
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("workflows")
}

/// 工作流运行记录。status 为事件投影的缓存（可随时从事件重建），不是事实源。
model WorkflowRun {
  id               String    @id @default(cuid())
  workflowId       String
  workflowVersion  Int
  input            String?
  /// 启动时的工作流定义快照（JSON）；恢复执行以此为准，避免定义后续演进影响历史 run
  definitionSnapshot String?
  /// 投影缓存：pending/running/suspended/waiting_human/completed/failed/canceled
  status           String    @default("pending")
  output           String?
  error            String?
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime  @default(now())

  @@index([workflowId])
  @@map("workflow_runs")
}

/// 执行事件表：只追加（append-only），禁止 UPDATE/DELETE。
/// 第 6-8 周的 Event Store 直接消费；seq 为运行内单调序号。
model WorkflowEvent {
  id        Int      @id @default(autoincrement())
  runId     String
  seq       Int
  type      String
  payload   String
  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@index([runId])
  @@map("workflow_events")
}

/// MCP Server 连接配置；transport 为 stdio（command+args）或 http（url）
model McpServer {
  id              String    @id @default(cuid())
  /// 全局唯一连接名，也是工具命名空间前缀
  name            String    @unique
  transport       String
  command         String?
  args            String?
  url             String?
  enabled         Boolean   @default(true)
  /// 运行时状态：disconnected / connecting / connected / error
  status          String    @default("disconnected")
  statusMessage   String?
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tools           McpTool[]

  @@map("mcp_servers")
}

/// 工具注册表（discovery 投影落库）；server 重连时全量替换
model McpTool {
  id           String    @id @default(cuid())
  serverId     String
  name         String
  title        String?
  description  String?
  inputSchema  String
  discoveredAt DateTime  @default(now())

  server McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
  @@map("mcp_tools")
}
