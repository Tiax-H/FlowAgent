{
  "name": "flowagent",
  "version": "0.1.0",
  "private": true,
  "description": "MCP-native durable agent workflow runtime",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "mcp:serve": "pnpm --filter @flowagent/bridge start",
    "seed:demos": "pnpm --filter @flowagent/demo seed",
    "db:generate": "pnpm --filter @flowagent/server db:generate",
    "db:migrate": "pnpm --filter @flowagent/server db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.18.0"
  }
}
