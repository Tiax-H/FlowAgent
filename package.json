{
  "name": "flowagent",
  "version": "0.1.0",
  "private": true,
  "description": "MCP-native durable agent workflow runtime",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "db:generate": "pnpm --filter @flowagent/server db:generate",
    "db:migrate": "pnpm --filter @flowagent/server db:migrate",
    "mcp:serve": "pnpm --filter @flowagent/server mcp:serve"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  }
}
